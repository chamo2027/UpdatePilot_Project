{
  "name": "@updatepilot/agent",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "scan-once": "tsx src/index.ts --once",
    "package:windows": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/windows/updatepilot-agent.cjs && powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File package-windows.ps1",
    "build": "tsc",
    "test": "npm run build && node --test test/winget.test.cjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@updatepilot/shared": "*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

{
  "name": "updatepilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-all.ps1",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-all.ps1",
    "dev:server": "npm --workspace=@updatepilot/server run dev",
    "dev:web": "npm --workspace=@updatepilot/web run dev",
    "dev:agent": "npm --workspace=@updatepilot/agent run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}